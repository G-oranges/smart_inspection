# ===== 数据库基本配置 =====

PORT=
# 注意：DATABASE_URL 已显式设置，不再依赖 ../backend/.env
DATABASE_URL=

# ===== 密码策略配置 =====
# 新用户初始密码（导入学生/教职工自动同步账号时使用）
# 必须符合密码复杂度要求：不少于8位，包含大小写字母、数字及标点符号
DEFAULT_INITIAL_PASSWORD=

# ===== SMTP 邮件服务配置（腾讯企业邮箱）=====
# 发送忘记密码验证码邮件需要配置以下选项
# 腾讯企业邮箱 SMTP 服务器地址
SMTP_HOST=
# SMTP 端口（465 为 SSL，587 为 TLS）
SMTP_PORT=
# 发件人邮箱账号（完整邮箱地址）
SMTP_USERNAME=
# 邮箱密码或授权码（建议使用授权码）
SMTP_PASSWORD=
# 发件人显示名称（可选，支持中文）
SMTP_FROM_NAME=
# 发件地址（如果不设置，默认使用 SMTP_USERNAME）
SMTP_FROM=
# 是否启用 SSL（默认 true）
SMTP_SSL=

# ===== 运行环境与 JWT 密钥 =====
# 运行环境：development / dev / local / test 视为开发环境；不设置则按生产环境处理
APP_ENV=
# Access Token 签名密钥（生产环境必填，至少 32 字节；缺失或过短服务将拒绝启动）
# 生成示例：openssl rand -hex 32
JWT_SECRET=
# Refresh Token 签名密钥（可选，至少 32 字节；不填则派生为 "<JWT_SECRET>_refresh"）
JWT_REFRESH_SECRET=
